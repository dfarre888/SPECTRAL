SUPABASE_SERVICE_ROLE_KEY
AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY
BEDROCK_MODEL_ID
WINDY_API_KEY
SPECTRAL_OIDC_CLIENT_SECRET

# Client-safe — domain-restricted tokens only
