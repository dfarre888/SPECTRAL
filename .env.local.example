# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── AWS Bedrock (sovereign AU inference — replaces Anthropic direct API) ────
# Supabase: ap-southeast-2 (Sydney) strict in-region ✓
# Bedrock:  ap-southeast-2 Geo cross-region routing (AU/NZ AP geography) ✓
#
# Setup:
#   1. AWS Console → Bedrock → Model access → ap-southeast-2
#      Enable: Claude Sonnet 4.6 (Anthropic)
#   2. IAM user policy: bedrock:InvokeModel on
#      arn:aws:bedrock:ap-southeast-2::foundation-model/ap.anthropic.*
#   3. Verify exact model ID in Bedrock console and set below
#
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# Geo cross-region model ID for Claude Sonnet 4.6 in ap-southeast-2.
# Verify exact ID in: AWS Console → Bedrock → Model catalog → Claude Sonnet 4.6
BEDROCK_MODEL_ID=ap.anthropic.claude-sonnet-4-6-20250514-v1:0

# PCM adjudication — set true to use placeholder stub instead of training core
# SPECTRAL_PCM_STUB_ADJUDICATION=false

# Cesium Ion (terrain + imagery tiles)
NEXT_PUBLIC_CESIUM_ION_TOKEN=your-cesium-ion-token

# Windy (server-only — map intel live wind mode)
WINDY_API_KEY=your-windy-api-key

# Edition: training (default) | operations (server propagation + adjudication)
# SPECTRAL_EDITION=operations
# NEXT_PUBLIC_SPECTRAL_EDITION=operations

# Dashboard skin: spectral (default) | a3dm — fleet command UI copy (Phase 3 A3DM adapter)
# NEXT_PUBLIC_PRODUCT_SKIN=a3dm

# Accredited catalogue resolver
SPECTRAL_ACCREDITED_RESOLVER=true

# OIDC SSO (Operations tenants — Keycloak / Azure AD)
# SPECTRAL_OIDC_ENABLED=true
# SPECTRAL_OIDC_ISSUER=https://idp.example.com/realms/spectral
# SPECTRAL_OIDC_CLIENT_ID=spectral-web
# SPECTRAL_OIDC_CLIENT_SECRET=server-only-secret
# NEXT_PUBLIC_SPECTRAL_OIDC_ENABLED=true
# NEXT_PUBLIC_SPECTRAL_OIDC_ISSUER=https://idp.example.com/realms/spectral
# NEXT_PUBLIC_SPECTRAL_OIDC_CLIENT_ID=spectral-web

# Cesium static asset base (optional override)
# Training/Vercel: /_next/static/Cesium  |  Helm/air-gap: /static/Cesium
NEXT_PUBLIC_CESIUM_BASE_URL=/_next/static/Cesium

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# Full capability local mode — bypass auth gate, service-role reads (development only; never in production)
NEXT_PUBLIC_DEMO_MODE=true

# Sage IEP Generator
BEDROCK_IEP_MODEL_ID=ap.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_IEP_SONNET_MODEL_ID=au.anthropic.claude-sonnet-4-6-20250514-v1:0
IEP_SONNET_ENABLED=false
NEXT_PUBLIC_IEP_SONNET_ENABLED=false

# SPECTRAL_DEMO_ADMIN_USER_ID=00000000-0000-0000-0000-000000000099
# SPECTRAL_TENANT_ID=00000000-0000-0000-0000-000000000001
# SPECTRAL_DEFAULT_TENANT=spectral-local
